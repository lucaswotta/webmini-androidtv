<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorButtonNormal" />
            <stroke android:width="3dp" android:color="?android:attr/colorAccent" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle">
                <solid android:color="?android:attr/colorButtonNormal" />
                <stroke android:width="1dp" android:color="?android:attr/colorControlNormal" />
            </shape></item>
            <item android:gravity="bottom" android:height="2dp">
                <shape android:shape="rectangle"><solid android:color="?android:attr/colorAccent" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
